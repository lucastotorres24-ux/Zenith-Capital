PORT=4000
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio

# Necesaria para la función de análisis con IA (routes/ai.js).
# Consíguela en https://platform.openai.com/api-keys
# Sin esto, el endpoint /api/ai/insights responde 503 (no rompe el resto de la app).
OPENAI_API_KEY=

# Opcional: verifica en tu dashboard de OpenAI cuál es el modelo económico
# vigente antes de asumir que este sigue existiendo (los nombres cambian).
OPENAI_MODEL=gpt-5.6-luna

# Opcional: si defines esto, TODO el sitio (incluida la pantalla de login)
# queda bloqueado detrás de un código de acceso único hasta que se
# escriba correctamente — pensado para que nadie que llegue al link por
# accidente pueda ni ver el login. Si lo dejas vacío, el sitio queda
# público como hasta ahora.
SITE_ACCESS_CODE=

# Opcional: código separado del anterior, solo para el panel de
# administrador (admin.html), donde se aprueban/editan/rechazan los
# depósitos, retiros, compras y ventas pendientes. Si lo dejas vacío, ese
# panel no funciona (no expone nada por error).
ADMIN_CODE=
